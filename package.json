{
  "name": "inkfold",
  "version": "2.19.0",
  "private": true,
  "description": "Developer tooling for the Inkfold Chrome extension. The extension itself (extension/) has no build step and no dependencies.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "check": "tsc -p jsconfig.json",
    "size": "node scripts/size-report.mjs",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
